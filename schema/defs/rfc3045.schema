# RFC 3045: Storing Vendor Information in the LDAP root DSE.
# https://www.rfc-editor.org/rfc/rfc3045.txt, read 2026-10-12.
#
# The root DSE publishes these when Server.Vendor and VendorVersion are set.
# Copied mechanically (only the line indentation differs).

# RFC 3045, section 2.1 vendorName
attributetype ( 1.3.6.1.1.4 NAME 'vendorName' EQUALITY
	  1.3.6.1.4.1.1466.109.114.1 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	  SINGLE-VALUE NO-USER-MODIFICATION USAGE dSAOperation )

# RFC 3045, section 2.2 vendorVersion
attributetype ( 1.3.6.1.1.5 NAME 'vendorVersion' EQUALITY
	  1.3.6.1.4.1.1466.109.114.1 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	  SINGLE-VALUE NO-USER-MODIFICATION USAGE dSAOperation )

