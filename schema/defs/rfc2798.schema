# RFC 2798: Definition of the inetOrgPerson LDAP Object Class.
# https://www.rfc-editor.org/rfc/rfc2798.txt, read 2026-10-12.
#
# Sections 2 and 3, copied mechanically from the RFC text (only the line
# indentation differs), and from Appendix 9 the three attribute types
# inetOrgPerson's MAY names that no current RFC defines: 'audio' and 'photo'
# (RFC 1274, dropped by RFC 4524) and 'labeledURI' (RFC 2079), and the
# 'Binary' syntax RFC 4517 dropped, which userSMIMECertificate and
# userPKCS12 still use.
#
# Appendix 9 restates many RFC 2256 definitions too; those are RFC 4519's
# now and are taken from there.
#
# Compared with OpenLDAP's inetorgperson.schema (commit
# dfea404feae1aa6b1d2c1be6271d5900f9af4c4f), ignoring DESC: the same.
# OpenLDAP's cosine.schema defines 'audio' as RFC 1274 did, with the Audio
# syntax (1.3.6.1.4.1.1466.115.121.1.4{25000}) and no EQUALITY; RFC 2798's
# appendix, below, gives octetStringMatch and Octet String{250000}. RFC 2798
# wins.

# RFC 2798, section 2.1 Vehicle license or registration plate.
attributetype ( 2.16.840.1.113730.3.1.1 NAME 'carLicense'
	  DESC 'vehicle license or registration plate'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 2798, section 2.2 Department number
attributetype ( 2.16.840.1.113730.3.1.2
	  NAME 'departmentNumber'
	  DESC 'identifies a department within an organization'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 2798, section 2.3 Display Name
attributetype ( 2.16.840.1.113730.3.1.241
	  NAME 'displayName'
	  DESC 'preferred name of a person to be used when displaying entries'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	  SINGLE-VALUE )

# RFC 2798, section 2.4 Employee Number
attributetype ( 2.16.840.1.113730.3.1.3
	  NAME 'employeeNumber'
	  DESC 'numerically identifies an employee within an organization'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	  SINGLE-VALUE )

# RFC 2798, section 2.5 Employee Type
attributetype ( 2.16.840.1.113730.3.1.4
	  NAME 'employeeType'
	  DESC 'type of employment for a person'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 2798, section 2.6 JPEG Photograph
attributetype ( 0.9.2342.19200300.100.1.60
	  NAME 'jpegPhoto'
	  DESC 'a JPEG image'
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.28 )

# RFC 2798, section 2.7 Preferred Language
attributetype ( 2.16.840.1.113730.3.1.39
	  NAME 'preferredLanguage'
	  DESC 'preferred written or spoken language for a person'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	  SINGLE-VALUE )

# RFC 2798, section 2.8 User S/MIME Certificate
attributetype ( 2.16.840.1.113730.3.1.40
	  NAME 'userSMIMECertificate'
	  DESC 'PKCS#7 SignedData used to support S/MIME'
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.5 )

# RFC 2798, section 2.9 User PKCS #12
attributetype ( 2.16.840.1.113730.3.1.216
	  NAME 'userPKCS12'
	  DESC 'PKCS #12 PFX PDU for exchange of personal identity information'
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.5 )

# RFC 2798, section 3 Definition of the inetOrgPerson Object Class
objectclass ( 2.16.840.1.113730.3.2.2
	    NAME 'inetOrgPerson'
	    SUP organizationalPerson
	    STRUCTURAL
	    MAY (
	        audio $ businessCategory $ carLicense $ departmentNumber $
	        displayName $ employeeNumber $ employeeType $ givenName $
	        homePhone $ homePostalAddress $ initials $ jpegPhoto $
	        labeledURI $ mail $ manager $ mobile $ o $ pager $
	        photo $ roomNumber $ secretary $ uid $ userCertificate $
	        x500uniqueIdentifier $ preferredLanguage $
	        userSMIMECertificate $ userPKCS12
	    )
	)

# RFC 2798, section 9.1.3 Attribute types from RFC 1274
attributetype ( 0.9.2342.19200300.100.1.55
	  NAME 'audio'
	  EQUALITY octetStringMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.40{250000} )

# RFC 2798, section 9.1.3 Attribute types from RFC 1274
#
# ⛔ As printed, ( 0.9.2342.19200300.100.1.7 NAME 'photo' ) is not a valid
# definition: RFC 4512 4.1.2 requires SUP or SYNTAX, and RFC 2798 only says
# the value is G3 fax per RFC 1274 9.3.7. G3 fax is RFC 4517's Fax syntax
# (3.3.12), and the SYNTAX below is the one OpenLDAP's cosine.schema gives.
attributetype ( 0.9.2342.19200300.100.1.7
	  NAME 'photo'
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.23{25000} )

# RFC 2798, section 9.2.1 Syntaxes from RFC 2252
# (RFC 4517 dropped 'Binary'; userSMIMECertificate and userPKCS12 use it)
ldapsyntax ( 1.3.6.1.4.1.1466.115.121.1.5 DESC 'Binary' )

# RFC 2798, section 9.1.4 Attribute type from RFC 2079
attributetype ( 1.3.6.1.4.1.250.1.57
	  NAME 'labeledURI'
	  EQUALITY caseExactMatch
	  SUBSTR caseExactSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

