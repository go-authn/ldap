# RFC 4524: COSINE LDAP/X.500 Schema.
# https://www.rfc-editor.org/rfc/rfc4524.txt, read 2026-10-12.
#
# Every attribute type of section 2 and object class of section 3, copied
# mechanically from the RFC text (only the line indentation differs).
# 'uid' and 'dc' are RFC 4519's (RFC 4524 A.1).
#
# OpenLDAP's cosine.schema (commit dfea404feae1aa6b1d2c1be6271d5900f9af4c4f)
# still carries the RFC 1274 definitions RFC 4524 dropped (pilotPerson,
# dNSDomain, photo, audio, ...); they are not here, except 'audio' and
# 'photo', which inetOrgPerson needs and RFC 2798 defines.
#
# Compared definition by definition with cosine.schema, ignoring DESC and
# the order of MUST and MAY lists, the other differences are second NAMEs
# OpenLDAP adds and RFC 4524 A.1 reserves without assigning: drink
# ('favouriteDrink'), homePhone ('homeTelephoneNumber'), mobile
# ('mobileTelephoneNumber'), pager ('pagerTelephoneNumber'), co
# ('friendlyCountryName'), mail ('rfc822Mailbox'), and the spelling
# 'RFC822localPart' for RFC 4524's 'rFC822localPart' (names are compared
# without regard to case, so that one is the same class). The RFC wins.

# RFC 4524, section 2.1 associatedDomain
attributetype ( 0.9.2342.19200300.100.1.37 NAME 'associatedDomain'
	  EQUALITY caseIgnoreIA5Match
	  SUBSTR caseIgnoreIA5SubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# RFC 4524, section 2.2 associatedName
attributetype ( 0.9.2342.19200300.100.1.38 NAME 'associatedName'
	  EQUALITY distinguishedNameMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

# RFC 4524, section 2.3 buildingName
attributetype ( 0.9.2342.19200300.100.1.48 NAME 'buildingName'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.4 co
attributetype ( 0.9.2342.19200300.100.1.43 NAME 'co'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4524, section 2.5 documentAuthor
attributetype ( 0.9.2342.19200300.100.1.14 NAME 'documentAuthor'
	  EQUALITY distinguishedNameMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

# RFC 4524, section 2.6 documentIdentifier
attributetype ( 0.9.2342.19200300.100.1.11 NAME 'documentIdentifier'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.7 documentLocation
attributetype ( 0.9.2342.19200300.100.1.15 NAME 'documentLocation'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.8 documentPublisher
attributetype ( 0.9.2342.19200300.100.1.56 NAME 'documentPublisher'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4524, section 2.9 documentTitle
attributetype ( 0.9.2342.19200300.100.1.12 NAME 'documentTitle'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.10 documentVersion
attributetype ( 0.9.2342.19200300.100.1.13 NAME 'documentVersion'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.11 drink
attributetype ( 0.9.2342.19200300.100.1.5 NAME 'drink'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.12 homePhone
attributetype ( 0.9.2342.19200300.100.1.20 NAME 'homePhone'
	  EQUALITY telephoneNumberMatch
	  SUBSTR telephoneNumberSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.50 )

# RFC 4524, section 2.13 homePostalAddress
attributetype ( 0.9.2342.19200300.100.1.39 NAME 'homePostalAddress'
	  EQUALITY caseIgnoreListMatch
	  SUBSTR caseIgnoreListSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.41 )

# RFC 4524, section 2.14 host
attributetype ( 0.9.2342.19200300.100.1.9 NAME 'host'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.15 info
attributetype ( 0.9.2342.19200300.100.1.4 NAME 'info'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{2048} )

# RFC 4524, section 2.16 mail
attributetype ( 0.9.2342.19200300.100.1.3 NAME 'mail'
	  EQUALITY caseIgnoreIA5Match
	  SUBSTR caseIgnoreIA5SubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )

# RFC 4524, section 2.17 manager
attributetype ( 0.9.2342.19200300.100.1.10 NAME 'manager'
	  EQUALITY distinguishedNameMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

# RFC 4524, section 2.18 mobile
attributetype ( 0.9.2342.19200300.100.1.41 NAME 'mobile'
	  EQUALITY telephoneNumberMatch
	  SUBSTR telephoneNumberSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.50 )

# RFC 4524, section 2.19 organizationalStatus
attributetype ( 0.9.2342.19200300.100.1.45 NAME 'organizationalStatus'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.20 pager
attributetype ( 0.9.2342.19200300.100.1.42 NAME 'pager'
	  EQUALITY telephoneNumberMatch
	  SUBSTR telephoneNumberSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.50 )

# RFC 4524, section 2.21 personalTitle
attributetype ( 0.9.2342.19200300.100.1.40 NAME 'personalTitle'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.22 roomNumber
attributetype ( 0.9.2342.19200300.100.1.6 NAME 'roomNumber'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.23 secretary
attributetype ( 0.9.2342.19200300.100.1.21 NAME 'secretary'
	  EQUALITY distinguishedNameMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

# RFC 4524, section 2.24 uniqueIdentifier
attributetype ( 0.9.2342.19200300.100.1.44 NAME 'uniqueIdentifier'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 2.25 userClass
attributetype ( 0.9.2342.19200300.100.1.8 NAME 'userClass'
	  EQUALITY caseIgnoreMatch
	  SUBSTR caseIgnoreSubstringsMatch
	  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} )

# RFC 4524, section 3.1 account
objectclass ( 0.9.2342.19200300.100.4.5 NAME 'account'
	  SUP top STRUCTURAL
	  MUST uid
	  MAY ( description $ seeAlso $ l $ o $ ou $ host ) )

# RFC 4524, section 3.2 document
objectclass ( 0.9.2342.19200300.100.4.6 NAME 'document'
	  SUP top STRUCTURAL
	  MUST documentIdentifier
	  MAY ( cn $ description $ seeAlso $ l $ o $ ou $
	    documentTitle $ documentVersion $ documentAuthor $
	    documentLocation $ documentPublisher ) )

# RFC 4524, section 3.3 documentSeries
objectclass ( 0.9.2342.19200300.100.4.9 NAME 'documentSeries'
	  SUP top STRUCTURAL
	  MUST cn
	  MAY ( description $ l $ o $ ou $ seeAlso $
	    telephonenumber ) )

# RFC 4524, section 3.4 domain
objectclass ( 0.9.2342.19200300.100.4.13 NAME 'domain'
	  SUP top STRUCTURAL
	  MUST dc
	  MAY ( userPassword $ searchGuide $ seeAlso $ businessCategory $
	    x121Address $ registeredAddress $ destinationIndicator $
	    preferredDeliveryMethod $ telexNumber $
	    teletexTerminalIdentifier $ telephoneNumber $
	    internationaliSDNNumber $ facsimileTelephoneNumber $ street $
	    postOfficeBox $ postalCode $ postalAddress $
	    physicalDeliveryOfficeName $ st $ l $ description $ o $
	    associatedName ) )

# RFC 4524, section 3.5 domainRelatedObject
objectclass ( 0.9.2342.19200300.100.4.17 NAME 'domainRelatedObject'
	  SUP top AUXILIARY
	  MUST associatedDomain )

# RFC 4524, section 3.6 friendlyCountry
objectclass ( 0.9.2342.19200300.100.4.18 NAME 'friendlyCountry'
	  SUP country STRUCTURAL
	  MUST co )

# RFC 4524, section 3.7 rFC822LocalPart
objectclass ( 0.9.2342.19200300.100.4.14 NAME 'rFC822localPart'
	  SUP domain STRUCTURAL
	  MAY ( cn $ description $ destinationIndicator $
	    facsimileTelephoneNumber $ internationaliSDNNumber $
	    physicalDeliveryOfficeName $ postalAddress $ postalCode $
	    postOfficeBox $ preferredDeliveryMethod $ registeredAddress $
	    seeAlso $ sn $ street $ telephoneNumber $
	    teletexTerminalIdentifier $ telexNumber $ x121Address ) )

# RFC 4524, section 3.8 room
objectclass ( 0.9.2342.19200300.100.4.7 NAME 'room'
	  SUP top STRUCTURAL
	  MUST cn
	  MAY ( roomNumber $ description $ seeAlso $ telephoneNumber ) )

# RFC 4524, section 3.9 simpleSecurityObject
objectclass ( 0.9.2342.19200300.100.4.19 NAME 'simpleSecurityObject'
	  SUP top AUXILIARY
	  MUST userPassword )

