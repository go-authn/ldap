# RFC 3672: Subentries in LDAP.
# https://www.rfc-editor.org/rfc/rfc3672.txt, read 2026-10-12.
#
# Here because the subschema subentry this library publishes is a subentry
# (RFC 4512 3.2 and 4.2): its structural class is 'subentry', which MUST
# have a 'subtreeSpecification'.
#
# ⛔ Two definitions are NOT in RFC 4512 4.1's order as printed: in the RFC
# text USAGE comes before SYNTAX in 'administrativeRole' and
# 'subtreeSpecification', and the ABNF puts SYNTAX first. Only the order
# below differs from the RFC; every term is the RFC's. OpenLDAP
# (schema_prep.c) prints them in the ABNF's order as well.

# RFC 3672, section 2.1 Subtree Specification Syntax
ldapsyntax ( 1.3.6.1.4.1.1466.115.121.1.45 DESC 'SubtreeSpecification' )

# RFC 3672, section 2.2 Administrative Role Attribute Type
# (reordered: SYNTAX before USAGE)
attributetype ( 2.5.18.5 NAME 'administrativeRole'
	EQUALITY objectIdentifierMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.38
	USAGE directoryOperation )

# RFC 3672, section 2.3 Subtree Specification Attribute Type
# (reordered: SYNTAX before SINGLE-VALUE and USAGE)
attributetype ( 2.5.18.6 NAME 'subtreeSpecification'
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.45
	SINGLE-VALUE
	USAGE directoryOperation )

# RFC 3672, section 2.4 Subentry Object Class
objectclass ( 2.5.17.0 NAME 'subentry'
	SUP top STRUCTURAL
	MUST ( cn $ subtreeSpecification ) )
