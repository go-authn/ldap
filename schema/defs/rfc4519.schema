# RFC 4519: LDAP Schema for User Applications.
# https://www.rfc-editor.org/rfc/rfc4519.txt, read 2026-10-12.
#
# Every attribute type of section 2 and object class of section 3, copied
# mechanically from the RFC text (only the line indentation differs).
#
# Compared definition by definition with OpenLDAP's core.schema
# (servers/slapd/schema/core.schema at commit
# dfea404feae1aa6b1d2c1be6271d5900f9af4c4f), ignoring DESC and the order of
# MUST and MAY lists. The RFC wins every one of these:
#
#   - OpenLDAP gives a second NAME to sn ('surname'), c ('countryName'),
#     l ('localityName'), st ('stateOrProvinceName'), street
#     ('streetAddress'), o ('organizationName'), ou
#     ('organizationalUnitName'), givenName ('gn'), facsimileTelephoneNumber
#     ('fax') and dc ('domainComponent'). RFC 4519 gives one. A filter on
#     (surname=x) is therefore Undefined here and not at slapd.
#   - OpenLDAP keeps RFC 2256's suggested upper bounds, which RFC 4519
#     dropped: serialNumber{64}, street{128}, businessCategory{128},
#     postalCode{40}, postOfficeBox{40}, physicalDeliveryOfficeName{128},
#     telephoneNumber{32}, x121Address{15}, internationalISDNNumber{16},
#     destinationIndicator{128}, houseIdentifier{32768}. A bound is a
#     suggestion (RFC 4512 4.1.2) and nothing enforces one.
#   - OpenLDAP has knowledgeInformation, presentationAddress,
#     supportedApplicationContext, protocolInformation, dmdName, pseudonym,
#     email, and the classes applicationEntity, dSA, dmd and
#     labeledURIObject; RFC 4519 does not, and neither does this file.

# RFC 4519, section 2.1 'businessCategory'
attributetype ( 2.5.4.15 NAME 'businessCategory'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.2 'c'
attributetype ( 2.5.4.6 NAME 'c'
	   SUP name
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.11
	   SINGLE-VALUE )

# RFC 4519, section 2.3 'cn'
attributetype ( 2.5.4.3 NAME 'cn'
	   SUP name )

# RFC 4519, section 2.4 'dc'
attributetype ( 0.9.2342.19200300.100.1.25 NAME 'dc'
	   EQUALITY caseIgnoreIA5Match
	   SUBSTR caseIgnoreIA5SubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
	   SINGLE-VALUE )

# RFC 4519, section 2.5 'description'
attributetype ( 2.5.4.13 NAME 'description'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.6 'destinationIndicator'
attributetype ( 2.5.4.27 NAME 'destinationIndicator'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.44 )

# RFC 4519, section 2.7 'distinguishedName'
attributetype ( 2.5.4.49 NAME 'distinguishedName'
	   EQUALITY distinguishedNameMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

# RFC 4519, section 2.8 'dnQualifier'
attributetype ( 2.5.4.46 NAME 'dnQualifier'
	   EQUALITY caseIgnoreMatch
	   ORDERING caseIgnoreOrderingMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.44 )

# RFC 4519, section 2.9 'enhancedSearchGuide'
attributetype ( 2.5.4.47 NAME 'enhancedSearchGuide'
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.21 )

# RFC 4519, section 2.10 'facsimileTelephoneNumber'
attributetype ( 2.5.4.23 NAME 'facsimileTelephoneNumber'
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.22 )

# RFC 4519, section 2.11 'generationQualifier'
attributetype ( 2.5.4.44 NAME 'generationQualifier'
	   SUP name )

# RFC 4519, section 2.12 'givenName'
attributetype ( 2.5.4.42 NAME 'givenName'
	   SUP name )

# RFC 4519, section 2.13 'houseIdentifier'
attributetype ( 2.5.4.51 NAME 'houseIdentifier'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.14 'initials'
attributetype ( 2.5.4.43 NAME 'initials'
	   SUP name )

# RFC 4519, section 2.15 'internationalISDNNumber'
attributetype ( 2.5.4.25 NAME 'internationalISDNNumber'
	   EQUALITY numericStringMatch
	   SUBSTR numericStringSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.36 )

# RFC 4519, section 2.16 'l'
attributetype ( 2.5.4.7 NAME 'l'
	   SUP name )

# RFC 4519, section 2.17 'member'
attributetype ( 2.5.4.31 NAME 'member'
	   SUP distinguishedName )

# RFC 4519, section 2.18 'name'
attributetype ( 2.5.4.41 NAME 'name'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.19 'o'
attributetype ( 2.5.4.10 NAME 'o'
	   SUP name )

# RFC 4519, section 2.20 'ou'
attributetype ( 2.5.4.11 NAME 'ou'
	   SUP name )

# RFC 4519, section 2.21 'owner'
attributetype ( 2.5.4.32 NAME 'owner'
	   SUP distinguishedName )

# RFC 4519, section 2.22 'physicalDeliveryOfficeName'
attributetype ( 2.5.4.19 NAME 'physicalDeliveryOfficeName'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.23 'postalAddress'
attributetype ( 2.5.4.16 NAME 'postalAddress'
	   EQUALITY caseIgnoreListMatch
	   SUBSTR caseIgnoreListSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.41 )

# RFC 4519, section 2.24 'postalCode'
attributetype ( 2.5.4.17 NAME 'postalCode'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.25 'postOfficeBox'
attributetype ( 2.5.4.18 NAME 'postOfficeBox'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.26 'preferredDeliveryMethod'
attributetype ( 2.5.4.28 NAME 'preferredDeliveryMethod'
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.14
	   SINGLE-VALUE )

# RFC 4519, section 2.27 'registeredAddress'
attributetype ( 2.5.4.26 NAME 'registeredAddress'
	   SUP postalAddress
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.41 )

# RFC 4519, section 2.28 'roleOccupant'
attributetype ( 2.5.4.33 NAME 'roleOccupant'
	   SUP distinguishedName )

# RFC 4519, section 2.29 'searchGuide'
attributetype ( 2.5.4.14 NAME 'searchGuide'
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.25 )

# RFC 4519, section 2.30 'seeAlso'
attributetype ( 2.5.4.34 NAME 'seeAlso'
	   SUP distinguishedName )

# RFC 4519, section 2.31 'serialNumber'
attributetype ( 2.5.4.5 NAME 'serialNumber'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.44 )

# RFC 4519, section 2.32 'sn'
attributetype ( 2.5.4.4 NAME 'sn'
	   SUP name )

# RFC 4519, section 2.33 'st'
attributetype ( 2.5.4.8 NAME 'st'
	   SUP name )

# RFC 4519, section 2.34 'street'
attributetype ( 2.5.4.9 NAME 'street'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.35 'telephoneNumber'
attributetype ( 2.5.4.20 NAME 'telephoneNumber'
	   EQUALITY telephoneNumberMatch
	   SUBSTR telephoneNumberSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.50 )

# RFC 4519, section 2.36 'teletexTerminalIdentifier'
attributetype ( 2.5.4.22 NAME 'teletexTerminalIdentifier'
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.51 )

# RFC 4519, section 2.37 'telexNumber'
attributetype ( 2.5.4.21 NAME 'telexNumber'
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.52 )

# RFC 4519, section 2.38 'title'
attributetype ( 2.5.4.12 NAME 'title'
	   SUP name )

# RFC 4519, section 2.39 'uid'
attributetype ( 0.9.2342.19200300.100.1.1 NAME 'uid'
	   EQUALITY caseIgnoreMatch
	   SUBSTR caseIgnoreSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# RFC 4519, section 2.40 'uniqueMember'
attributetype ( 2.5.4.50 NAME 'uniqueMember'
	   EQUALITY uniqueMemberMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.34 )

# RFC 4519, section 2.41 'userPassword'
attributetype ( 2.5.4.35 NAME 'userPassword'
	   EQUALITY octetStringMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 )

# RFC 4519, section 2.42 'x121Address'
attributetype ( 2.5.4.24 NAME 'x121Address'
	   EQUALITY numericStringMatch
	   SUBSTR numericStringSubstringsMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.36 )

# RFC 4519, section 2.43 'x500UniqueIdentifier'
attributetype ( 2.5.4.45 NAME 'x500UniqueIdentifier'
	   EQUALITY bitStringMatch
	   SYNTAX 1.3.6.1.4.1.1466.115.121.1.6 )

# RFC 4519, section 3.1 'applicationProcess'
objectclass ( 2.5.6.11 NAME 'applicationProcess'
	   SUP top
	   STRUCTURAL
	   MUST cn
	   MAY ( seeAlso $
	         ou $
	         l $
	         description ) )

# RFC 4519, section 3.2 'country'
objectclass ( 2.5.6.2 NAME 'country'
	   SUP top
	   STRUCTURAL
	   MUST c
	   MAY ( searchGuide $
	         description ) )

# RFC 4519, section 3.3 'dcObject'
objectclass ( 1.3.6.1.4.1.1466.344 NAME 'dcObject'
	   SUP top
	   AUXILIARY
	   MUST dc )

# RFC 4519, section 3.4 'device'
objectclass ( 2.5.6.14 NAME 'device'
	   SUP top
	   STRUCTURAL
	   MUST cn
	   MAY ( serialNumber $
	         seeAlso $
	         owner $
	         ou $
	         o $
	         l $
	         description ) )

# RFC 4519, section 3.5 'groupOfNames'
objectclass ( 2.5.6.9 NAME 'groupOfNames'
	   SUP top
	   STRUCTURAL
	   MUST ( member $
	         cn )
	   MAY ( businessCategory $
	         seeAlso $
	         owner $
	         ou $
	         o $
	         description ) )

# RFC 4519, section 3.6 'groupOfUniqueNames'
objectclass ( 2.5.6.17 NAME 'groupOfUniqueNames'
	   SUP top
	   STRUCTURAL
	   MUST ( uniqueMember $
	         cn )
	   MAY ( businessCategory $
	         seeAlso $
	         owner $
	         ou $
	         o $
	         description ) )

# RFC 4519, section 3.7 'locality'
objectclass ( 2.5.6.3 NAME 'locality'
	   SUP top
	   STRUCTURAL
	   MAY ( street $
	         seeAlso $
	         searchGuide $
	         st $
	         l $
	         description ) )

# RFC 4519, section 3.8 'organization'
objectclass ( 2.5.6.4 NAME 'organization'
	   SUP top
	   STRUCTURAL
	   MUST o
	   MAY ( userPassword $ searchGuide $ seeAlso $
	         businessCategory $ x121Address $ registeredAddress $
	         destinationIndicator $ preferredDeliveryMethod $
	         telexNumber $ teletexTerminalIdentifier $
	         telephoneNumber $ internationalISDNNumber $
	         facsimileTelephoneNumber $ street $ postOfficeBox $
	         postalCode $ postalAddress $ physicalDeliveryOfficeName $
	         st $ l $ description ) )

# RFC 4519, section 3.9 'organizationalPerson'
objectclass ( 2.5.6.7 NAME 'organizationalPerson'
	   SUP person
	   STRUCTURAL
	   MAY ( title $ x121Address $ registeredAddress $
	         destinationIndicator $ preferredDeliveryMethod $
	         telexNumber $ teletexTerminalIdentifier $
	         telephoneNumber $ internationalISDNNumber $
	         facsimileTelephoneNumber $ street $ postOfficeBox $
	         postalCode $ postalAddress $ physicalDeliveryOfficeName $
	         ou $ st $ l ) )

# RFC 4519, section 3.10 'organizationalRole'
objectclass ( 2.5.6.8 NAME 'organizationalRole'
	   SUP top
	   STRUCTURAL
	   MUST cn
	   MAY ( x121Address $ registeredAddress $ destinationIndicator $
	         preferredDeliveryMethod $ telexNumber $
	         teletexTerminalIdentifier $ telephoneNumber $
	         internationalISDNNumber $ facsimileTelephoneNumber $
	         seeAlso $ roleOccupant $ preferredDeliveryMethod $
	         street $ postOfficeBox $ postalCode $ postalAddress $
	         physicalDeliveryOfficeName $ ou $ st $ l $
	         description ) )

# RFC 4519, section 3.11 'organizationalUnit'
objectclass ( 2.5.6.5 NAME 'organizationalUnit'
	   SUP top
	   STRUCTURAL
	   MUST ou
	   MAY ( businessCategory $ description $ destinationIndicator $
	         facsimileTelephoneNumber $ internationalISDNNumber $ l $
	         physicalDeliveryOfficeName $ postalAddress $ postalCode $
	         postOfficeBox $ preferredDeliveryMethod $
	         registeredAddress $ searchGuide $ seeAlso $ st $ street $
	         telephoneNumber $ teletexTerminalIdentifier $
	         telexNumber $ userPassword $ x121Address ) )

# RFC 4519, section 3.12 'person'
objectclass ( 2.5.6.6 NAME 'person'
	   SUP top
	   STRUCTURAL
	   MUST ( sn $
	         cn )
	   MAY ( userPassword $
	         telephoneNumber $
	         seeAlso $ description ) )

# RFC 4519, section 3.13 'residentialPerson'
objectclass ( 2.5.6.10 NAME 'residentialPerson'
	   SUP person
	   STRUCTURAL
	   MUST l
	   MAY ( businessCategory $ x121Address $ registeredAddress $
	         destinationIndicator $ preferredDeliveryMethod $
	         telexNumber $ teletexTerminalIdentifier $
	         telephoneNumber $ internationalISDNNumber $
	         facsimileTelephoneNumber $ preferredDeliveryMethod $
	         street $ postOfficeBox $ postalCode $ postalAddress $
	         physicalDeliveryOfficeName $ st $ l ) )

# RFC 4519, section 3.14 'uidObject'
objectclass ( 1.3.6.1.1.3.1 NAME 'uidObject'
	   SUP top
	   AUXILIARY
	   MUST uid )

